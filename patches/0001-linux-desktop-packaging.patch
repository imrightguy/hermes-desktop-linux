     return True
 
 
+def _project_root() -> Path:
+    from hermes_cli.main import PROJECT_ROOT
+
+    return PROJECT_ROOT
+
+
+def _launch_linux_packaged_client(args: argparse.Namespace) -> bool:
+    """Launch the Flatpak or Snap desktop client, or return False for the local build.
+
+    ``--source`` keeps the checkout build. Flatpak is the Flathub client.
+    ``--snapd`` builds the snap from this workspace. The native CLI and
+    ``~/.hermes`` stay outside the package.
+    """
+    if not sys.platform.startswith("linux") or getattr(args, "source", False):
+        return False
+    flatpak = bool(getattr(args, "flatpak", False))
+    snapd = bool(getattr(args, "snapd", False))
+    if not flatpak and not snapd:
+        return False
+
+    cwd = getattr(args, "cwd", None) or os.getcwd()
+    if flatpak:
+        from hermes_cli.flatpak_desktop import (
+            ensure_installed,
+            launch_with_native_backend,
+        )
+
+        if getattr(args, "build_only", False):
+            sys.exit(0 if ensure_installed() else 1)
+        sys.exit(
+            launch_with_native_backend(
+                [sys.executable, "-m", "hermes_cli.main"],
+                cwd=cwd,
+            )
+        )
+
+    from hermes_cli.snap_desktop import (
+        build_snap,
+        install_snap,
+        launch_with_native_backend as launch_snap,
+    )
+
+    snap_path = build_snap(_project_root())
+    if snap_path is None or not install_snap(snap_path):
+        sys.exit(1)
+    sys.exit(
+        launch_snap(
+            [sys.executable, "-m", "hermes_cli.main"],
+            cwd=cwd,
+        )
+    )
+
+
 def cmd_gui(args: argparse.Namespace):
     """Build and launch the native Electron desktop GUI."""
+    if _launch_linux_packaged_client(args):
+        return
     from hermes_cli.main import PROJECT_ROOT
     from hermes_cli.source_build import prepare_source_dependencies, source_build_env
     desktop_dir = PROJECT_ROOT / "apps" / "desktop"
